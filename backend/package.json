{
	"name": "backend",
	"version": "0.0.1",
	"description": "",
	"author": "",
	"private": true,
	"license": "UNLICENSED",
	"type": "module",
	"scripts": {
		"build": "nest build",
		"deploy": "nest deploy",
		"start": "nest start",
		"start:dev": "nest start --watch --no-shell",
		"start:debug": "nest start --debug --watch",
		"start:prod": "node dist/main",
		"format": "biome format --write .",
		"lint": "biome lint --write .",
		"check": "biome check .",
		"migration:create": "typeorm migration:create",
		"migration:generate": "typeorm migration:generate dist/database/migrations/Init -d dist/data-source.js",
		"migration:run": "typeorm migration:run -d dist/data-source.js",
		"migration:revert": "typeorm migration:revert -d dist/data-source.js",
		"seed": "node dist/infrastructure/database/seeds/run.js"
	},
	"dependencies": {
		"@nestjs/common": "^12.0.1",
		"@nestjs/config": "^12.0.0",
		"@nestjs/core": "^12.0.1",
		"@nestjs/jwt": "^12.0.2",
		"@nestjs/mapped-types": "^12.0.0",
		"@nestjs/platform-express": "^12.0.1",
		"@nestjs/typeorm": "^12.0.1",
		"class-transformer": "^0.5.1",
		"class-validator": "^0.15.1",
		"cookie-parser": "^1.4.7",
		"firebase-admin": "^14.4.0",
		"pg": "^8.23.0",
		"reflect-metadata": "^0.2.2",
		"rxjs": "^7.8.1",
		"typeorm": "^1.1.1",
		"typeorm-extension": "^4.1.0",
		"zod": "^4.6.5"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.14",
		"@nestjs/cli": "^12.0.0",
		"@nestjs/mau": "^0.2.6",
		"@nestjs/schematics": "^12.0.0",
		"@types/cookie-parser": "^1.4.10",
		"@types/express": "^5.0.0",
		"@types/node": "^24.0.0",
		"dotenv": "^18.0.2",
		"source-map-support": "^0.5.21",
		"supertest": "^7.0.0",
		"typescript": "^6.0.2"
	}
}
